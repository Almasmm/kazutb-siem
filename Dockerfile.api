# syntax=docker/dockerfile:1.7
FROM golang:1.26.6-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go test ./... && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kcsp-api ./cmd/api && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kcsp-processor ./cmd/processor

FROM alpine:3.22
RUN addgroup -S kcsp && adduser -S -G kcsp -H kcsp
COPY --from=build /out/kcsp-api /usr/local/bin/kcsp-api
COPY --from=build /out/kcsp-processor /usr/local/bin/kcsp-processor
USER kcsp
EXPOSE 8080
CMD ["/usr/local/bin/kcsp-api"]
