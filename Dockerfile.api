# syntax=docker/dockerfile:1.7
FROM golang:1.26.6-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go test ./... && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kcsp-api ./cmd/api && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kcsp-collector ./cmd/collector && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kcsp-processor ./cmd/processor && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kcsp-soar-worker ./cmd/soar-worker && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kcsp-ai-worker ./cmd/ai-worker && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kcsp-tenant-acceptance ./cmd/tenant-acceptance

FROM alpine:3.22
RUN addgroup -S -g 10001 kcsp && \
    adduser -S -D -H -u 10001 -G kcsp kcsp && \
    mkdir -p /var/lib/kcsp-collector && \
    chown -R kcsp:kcsp /var/lib/kcsp-collector
COPY --from=build /out/kcsp-api /usr/local/bin/kcsp-api
COPY --from=build /out/kcsp-collector /usr/local/bin/kcsp-collector
COPY --from=build /out/kcsp-processor /usr/local/bin/kcsp-processor
COPY --from=build /out/kcsp-soar-worker /usr/local/bin/kcsp-soar-worker
COPY --from=build /out/kcsp-ai-worker /usr/local/bin/kcsp-ai-worker
COPY --from=build /out/kcsp-tenant-acceptance /usr/local/bin/kcsp-tenant-acceptance
USER kcsp
EXPOSE 8080 8081 5514/tcp 5514/udp 6514/tcp
CMD ["/usr/local/bin/kcsp-api"]
