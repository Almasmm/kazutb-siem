# Development-only Compose values. Use a secret manager in production.
KCSP_POSTGRES_PASSWORD=replace-with-a-local-development-password
KCSP_CLICKHOUSE_PASSWORD=replace-with-a-local-development-password
KCSP_VALKEY_PASSWORD=replace-with-a-local-development-password
KCSP_MINIO_ROOT_USER=replace-with-a-local-development-access-key
KCSP_MINIO_ROOT_PASSWORD=replace-with-a-local-development-secret-key
KCSP_GRAFANA_ADMIN_PASSWORD=replace-with-a-local-development-grafana-password

# DR target. In production this endpoint must be a separate failure domain over
# TLS; the local HTTP values only support the isolated Compose restore drill.
KCSP_DR_TARGET_ENDPOINT=http://backup-store:9000
KCSP_DR_TARGET_ACCESS_KEY=replace-with-a-local-development-backup-access-key
KCSP_DR_TARGET_SECRET_KEY=replace-with-a-local-development-backup-secret-key
KCSP_DR_TARGET_ALLOW_INSECURE=true
KCSP_DR_MANIFEST_HMAC_KEY=replace-with-at-least-32-random-bytes-kept-outside-the-backup-store
KCSP_DR_RPO_SECONDS=86400
KCSP_DR_RTO_SECONDS=3600
KCSP_DR_SCHEDULE_SECONDS=21600
KCSP_DR_RETENTION_DAYS=30
KCSP_DR_MINIMUM_BACKUPS=7

# PostgreSQL PITR. The local proxy uses a short-lived self-signed certificate;
# production must point directly to a verified off-site TLS S3 endpoint.
KCSP_PITR_ENABLED=false
KCSP_PITR_SCHEDULER_ENABLED=true
KCSP_PITR_S3_ENDPOINT=pitr-s3-proxy
KCSP_PITR_S3_PORT=9443
KCSP_PITR_S3_BUCKET=kcsp-dr
KCSP_PITR_S3_REGION=us-east-1
KCSP_PITR_TLS_VERIFY=n
# For the local backup-store these two values must match KCSP_DR_TARGET_*.
# Provision a separate least-privilege credential on production S3.
KCSP_PITR_S3_ACCESS_KEY=replace-with-a-local-development-backup-access-key
KCSP_PITR_S3_SECRET_KEY=replace-with-a-local-development-backup-secret-key
KCSP_PITR_REPO_CIPHER_PASS=replace-with-at-least-32-random-bytes-kept-outside-the-repository
KCSP_PITR_ARCHIVE_TIMEOUT_SECONDS=60
KCSP_PITR_RPO_SECONDS=300
KCSP_PITR_SCHEDULE_SECONDS=21600
KCSP_PITR_FULL_INTERVAL_SECONDS=604800
KCSP_PITR_RETENTION_FULL=7
KCSP_PITR_RETENTION_DIFF=14
KCSP_PITR_RTO_SECONDS=3600

# Small-HA PostgreSQL/Patroni profile. Generate independent random values.
KCSP_HA_POSTGRES_PASSWORD=replace-with-at-least-24-random-bytes
KCSP_HA_REPLICATION_PASSWORD=replace-with-at-least-24-different-random-bytes
KCSP_HA_REWIND_PASSWORD=replace-with-at-least-24-another-random-bytes

# Production API OIDC settings (Keycloak-compatible discovery/JWKS).
KCSP_AUTH_MODE=oidc
KCSP_OIDC_ISSUER_URL=https://identity.example.edu/realms/kcsp
KCSP_OIDC_CLIENT_ID=kcsp-web
KCSP_REQUIRE_REGISTERED_COLLECTORS=true
KCSP_AGENT_CREDENTIAL_TTL=720h
KCSP_AGENT_ENROLLMENT_MAX_TTL=168h
KCSP_AGENT_ENROLLMENT_RATE_PER_MINUTE=600
KCSP_LAB_BOOTSTRAP=false
KCSP_VALKEY_URL=redis://kcsp@valkey:6379/0
KCSP_VALKEY_NAMESPACE=kcsp
KCSP_LICENSE_TRUSTED_KEYS_JSON={"campus-license-2026":"base64-ed25519-public-key"}
KCSP_COLLECTOR_HTTP_TOKEN=replace-with-a-long-random-development-token
KCSP_COLLECTOR_FILE_SOURCES_JSON=[]

# Production web image build arguments.
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://identity.example.edu/realms/kcsp
VITE_OIDC_CLIENT_ID=kcsp-web
VITE_TENANT_ID=university-kulazhanov

# Cross-platform lightweight agent. Use a collector-scoped OIDC token and mTLS files.
KCSP_AGENT_SERVER_URL=https://soc.example.edu
KCSP_AGENT_TENANT_ID=university-kulazhanov
# First boot uses a one-time enrollment token; the resulting credential is
# written privately below. OAuth or a static access token remains supported.
KCSP_AGENT_ENROLLMENT_TOKEN=replace-with-one-time-enrollment-token
KCSP_AGENT_ID=
KCSP_AGENT_NAME=
KCSP_AGENT_CREDENTIAL_FILE=
KCSP_AGENT_IDENTITY_FILE=
KCSP_AGENT_CREDENTIAL_ROTATE_BEFORE=24h
KCSP_AGENT_ACCESS_TOKEN=
KCSP_AGENT_SOURCE=auto
# Where a channel starts the first time it is seen: FROM_NOW, LAST_1_HOUR,
# LAST_24_HOURS or FROM_BEGINNING. FROM_NOW keeps a newly enrolled endpoint from
# replaying the whole retained journal; use FROM_BEGINNING only for backfill.
KCSP_AGENT_INITIAL_CURSOR=FROM_NOW
KCSP_AGENT_SYSMON_CHANNEL=Microsoft-Windows-Sysmon/Operational
# Windows channels are semicolon-separated and maintain independent checkpoints.
KCSP_AGENT_WINDOWS_CHANNELS=Security;System;Microsoft-Windows-PowerShell/Operational;Microsoft-Windows-Windows Defender/Operational
# Linux journald filters are space-separated FIELD=value expressions.
KCSP_AGENT_JOURNAL_MATCHES=
KCSP_AGENT_CA_FILE=C:\ProgramData\KCSP\pki\ca.pem
KCSP_AGENT_CERT_FILE=C:\ProgramData\KCSP\pki\agent.pem
KCSP_AGENT_KEY_FILE=C:\ProgramData\KCSP\pki\agent-key.pem
KCSP_AGENT_STATE_DIR=C:\ProgramData\KCSP\agent
KCSP_AGENT_QUEUE_MAX_BYTES=1073741824
KCSP_AGENT_BATCH_SIZE=100
KCSP_AGENT_BATCH_MAX_BYTES=8388608
