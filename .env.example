# Development-only Compose values. Use a secret manager in production.
KCSP_POSTGRES_PASSWORD=replace-with-a-local-development-password
KCSP_CLICKHOUSE_PASSWORD=replace-with-a-local-development-password
KCSP_MINIO_ROOT_USER=replace-with-a-local-development-access-key
KCSP_MINIO_ROOT_PASSWORD=replace-with-a-local-development-secret-key
KCSP_GRAFANA_ADMIN_PASSWORD=replace-with-a-local-development-grafana-password

# DR target. In production this endpoint must be a separate failure domain over
# TLS; the local HTTP values only support the isolated Compose restore drill.
KCSP_DR_TARGET_ENDPOINT=http://backup-store:9000
KCSP_DR_TARGET_ACCESS_KEY=replace-with-a-local-development-backup-access-key
KCSP_DR_TARGET_SECRET_KEY=replace-with-a-local-development-backup-secret-key
KCSP_DR_TARGET_ALLOW_INSECURE=true
KCSP_DR_MANIFEST_HMAC_KEY=replace-with-at-least-32-random-bytes-kept-outside-the-backup-store
KCSP_DR_RPO_SECONDS=86400
KCSP_DR_RTO_SECONDS=3600
KCSP_DR_SCHEDULE_SECONDS=21600
KCSP_DR_RETENTION_DAYS=30
KCSP_DR_MINIMUM_BACKUPS=7

# Production API OIDC settings (Keycloak-compatible discovery/JWKS).
KCSP_AUTH_MODE=oidc
KCSP_OIDC_ISSUER_URL=https://identity.example.edu/realms/kcsp
KCSP_OIDC_CLIENT_ID=kcsp-web
KCSP_REQUIRE_REGISTERED_COLLECTORS=true

# Production web image build arguments.
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://identity.example.edu/realms/kcsp
VITE_OIDC_CLIENT_ID=kcsp-web
VITE_TENANT_ID=university-kulazhanov

# Windows lightweight agent. Use a collector-scoped OIDC token and mTLS files.
KCSP_AGENT_SERVER_URL=https://soc.example.edu
KCSP_AGENT_TENANT_ID=university-kulazhanov
KCSP_AGENT_ACCESS_TOKEN=replace-with-short-lived-collector-token
KCSP_AGENT_CA_FILE=C:\ProgramData\KCSP\pki\ca.pem
KCSP_AGENT_CERT_FILE=C:\ProgramData\KCSP\pki\agent.pem
KCSP_AGENT_KEY_FILE=C:\ProgramData\KCSP\pki\agent-key.pem
KCSP_AGENT_STATE_DIR=C:\ProgramData\KCSP\agent
KCSP_AGENT_QUEUE_MAX_BYTES=1073741824
