# syntax=docker/dockerfile:1.7
FROM golang:1.26.6-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/dr ./cmd/dr
COPY internal/dr ./internal/dr
RUN go test ./internal/dr ./cmd/dr && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kcsp-dr ./cmd/dr

FROM clickhouse/clickhouse-server:26.6-alpine
USER root
RUN apk add --no-cache ca-certificates postgresql17-client && \
    mkdir -p /var/lib/kcsp/dr /var/lib/kcsp/clickhouse-backups && \
    chown -R clickhouse:clickhouse /var/lib/kcsp
COPY --from=build /out/kcsp-dr /usr/local/bin/kcsp-dr
USER clickhouse
ENTRYPOINT ["/usr/local/bin/kcsp-dr"]
CMD ["backup"]
