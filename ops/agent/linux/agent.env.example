# KCSP Linux agent configuration. Install this file as /etc/kcsp/agent.env
# with owner root:root and mode 0600.
KCSP_AGENT_SERVER_URL=https://soc.kaztbu.kz
KCSP_AGENT_TENANT_ID=replace-with-tenant-id
KCSP_AGENT_ENROLLMENT_TOKEN=replace-with-one-time-enrollment-token
KCSP_AGENT_SOURCE=journald
KCSP_AGENT_JOURNAL_MATCHES=
KCSP_AGENT_QUEUE_MAX_BYTES=1073741824
KCSP_AGENT_BATCH_SIZE=100
KCSP_AGENT_BATCH_MAX_BYTES=8388608
KCSP_AGENT_POLL_INTERVAL=2s
KCSP_AGENT_HEARTBEAT_INTERVAL=30s
KCSP_AGENT_CREDENTIAL_ROTATE_BEFORE=24h

# Set this when KCSP uses a private certificate authority.
# KCSP_AGENT_CA_FILE=/etc/kcsp/ca.crt

# Optional mTLS identity. The private key must be readable only by kcsp-agent.
# KCSP_AGENT_CERT_FILE=/etc/kcsp/agent.crt
# KCSP_AGENT_KEY_FILE=/etc/kcsp/agent.key
