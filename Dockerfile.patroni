# syntax=docker/dockerfile:1.7
FROM kcsp-postgres:17

USER root
RUN apk add --no-cache py3-pip py3-psycopg2 python3 && \
    python3 -m venv --system-site-packages /opt/patroni && \
    /opt/patroni/bin/pip install --no-cache-dir "patroni[etcd3]==4.1.5" && \
    apk del py3-pip && \
    rm -rf /opt/patroni/bin/pip* \
      /opt/patroni/lib/python*/site-packages/pip* \
      /opt/patroni/lib/python*/site-packages/setuptools* \
      /opt/patroni/lib/python*/site-packages/_distutils_hack && \
    mkdir -p /etc/patroni /var/lib/postgresql/data /var/run/postgresql && \
    chown -R postgres:postgres /etc/patroni /var/lib/postgresql /var/run/postgresql

COPY ops/patroni/render.py /usr/local/bin/kcsp-render-patroni
COPY ops/patroni/entrypoint.sh /usr/local/bin/kcsp-patroni-entrypoint
COPY ops/patroni/post-init.sh /usr/local/bin/kcsp-patroni-post-init
COPY ops/patroni/self-test.sh /usr/local/bin/kcsp-patroni-self-test

RUN chmod 0755 /usr/local/bin/kcsp-patroni-* /usr/local/bin/kcsp-render-patroni && \
    /opt/patroni/bin/patroni --version && \
    /usr/local/bin/kcsp-patroni-self-test

USER postgres
ENTRYPOINT ["/usr/local/bin/kcsp-patroni-entrypoint"]
