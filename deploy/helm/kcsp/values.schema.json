{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "images", "secrets", "config", "workloads"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["version", "profile", "tenant"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "enum": ["production", "staging", "development"]},
        "tenant": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
            "name": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "images": {
      "type": "object",
      "required": ["api", "processor", "soar-worker", "ai-worker", "web"],
      "additionalProperties": {
        "type": "object",
        "required": ["repository", "tag", "pullPolicy"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "tag": {"type": "string", "minLength": 1},
          "digest": {
            "type": "string",
            "pattern": "^(|sha256:[0-9a-f]{64})$"
          },
          "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret", "keys"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "connectorExistingSecret": {"type": "string"},
        "keys": {
          "type": "object",
          "required": [
            "databaseURL",
            "clickhouseURL",
            "minioAccessKey",
            "minioSecretKey",
            "aiLocalAPIKey",
            "aiCloudAPIKey"
          ],
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["auth", "kafka", "minio"],
      "properties": {
        "auth": {
          "type": "object",
          "required": ["mode", "oidc"],
          "properties": {
            "mode": {"type": "string", "enum": ["oidc", "trusted_headers", "development"]},
            "oidc": {
              "type": "object",
              "required": ["issuerURL", "clientID", "rolesClaim", "permissionClaim", "tenantClaim"],
              "properties": {
                "issuerURL": {"type": "string", "minLength": 1},
                "clientID": {"type": "string", "minLength": 1},
                "rolesClaim": {"type": "string", "minLength": 1},
                "permissionClaim": {"type": "string", "minLength": 1},
                "tenantClaim": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "kafka": {
          "type": "object",
          "required": ["brokers", "rawTopic", "dlqTopic", "consumerGroup", "partitions", "replicationFactor"],
          "properties": {
            "brokers": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 3}
            },
            "partitions": {"type": "integer", "minimum": 1},
            "replicationFactor": {"type": "integer", "minimum": 1}
          }
        },
        "minio": {
          "type": "object",
          "required": ["endpoint", "secure", "region", "evidenceBucket"],
          "properties": {
            "endpoint": {"type": "string", "minLength": 1},
            "secure": {"type": "boolean"},
            "region": {"type": "string", "minLength": 1},
            "evidenceBucket": {"type": "string", "minLength": 3}
          }
        }
      }
    },
    "workloads": {
      "type": "object",
      "required": ["api", "processor", "soar-worker", "ai-worker", "web"],
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "replicas", "containerPort", "service", "pdb", "autoscaling", "probes", "resources"],
        "properties": {
          "enabled": {"type": "boolean"},
          "replicas": {"type": "integer", "minimum": 1},
          "containerPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
          "terminationGracePeriodSeconds": {"type": "integer", "minimum": 10, "maximum": 600},
          "autoscaling": {
            "type": "object",
            "required": ["enabled", "minReplicas", "maxReplicas"],
            "properties": {
              "enabled": {"type": "boolean"},
              "minReplicas": {"type": "integer", "minimum": 1},
              "maxReplicas": {"type": "integer", "minimum": 1},
              "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 0, "maximum": 100},
              "targetMemoryUtilizationPercentage": {"type": "integer", "minimum": 0, "maximum": 100}
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "hosts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["host", "path", "pathType"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "path": {"type": "string", "pattern": "^/"},
              "pathType": {"type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"]}
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "externalEgressCidrs", "externalEgressPorts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "externalEgressCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "externalEgressPorts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["port", "protocol"],
            "properties": {
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "protocol": {"type": "string", "enum": ["TCP", "UDP", "SCTP"]}
            }
          }
        }
      }
    }
  }
}
